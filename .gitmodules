# The vendored GTVHacker kernel + base initramfs + 2008 ARM toolchain the
# firmware build reads (through NEST_ATTACK_DIR). Pinned to upstream
# exploiteers/NestDFUAttack, and deliberately *unpatched*: everything we change
# there — scripts/mkcompile_h, the timeconst.pl Perl fix, the initramfs
# injection, the toolchain wrappers — is applied to a copy at build time, so the
# gitlink is still upstream's only commit (930b834b). If that ever stops being
# true, fork it then rather than hiding kernel edits in this repo.
# HTTPS so a plain `git submodule update --init` works without keys.
#
# ignore = dirty because a macOS/APFS checkout collapses the 13 case-only
# netfilter paths — see AGENTS.md trap 3.
[submodule "NestDFUAttack"]
	path = NestDFUAttack
	url = https://github.com/exploiteers/NestDFUAttack.git
	branch = master
	ignore = dirty
