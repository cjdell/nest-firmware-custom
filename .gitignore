# Vendored upstream checkouts that are not needed to build the flake outputs.
# They are NOT flake inputs and not submodules; the builder stages them on demand
# via NEST_ATTACK_DIR. (NestDFUAttack/ is a tracked, pinned submodule instead —
# see .gitmodules.) The Hubitat app/driver we run are NOT here any more: they are
# vendored, patched and tracked under hubitat/.
/NoLongerEvil-SelfHosted/
/NoLongerEvil-Thermostat/
/hubitatcontrol/

# Build outputs
/dist/
/result
/result-*
/nest-ondevice-server/target/
/.direnv/
/firmware-out/

# Python bytecode from the firmware helper scripts
__pycache__/
*.pyc

# The schedule SPA's dependencies and test scratch. ui/dist IS tracked: it is
# embedded into the binary at compile time and the nix build has no Bun.
node_modules/
/nest-ondevice-server/ui/test/.out/
