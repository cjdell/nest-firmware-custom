#!/bin/sh
# build — the only build command in this repo.
#
#   ./build firmware     # uImage to flash          -> dist/uImage
#   ./build server       # the ARM server binary    -> dist/nest-ondevice
#   ./build initramfs    # patched initramfs cpio   -> dist/initramfs.cpio
#   ./build all          # firmware + server + initramfs
#   ./build ui           # rebuild the schedule SPA bundle -> ui/dist (needs Bun)
#   ./build qemu         # boot the image under qemu-system-arm, assert HTTP works
#   ./build test         # the on-device half of the image, against fixtures
#   ./build repro        # prove the image is host-independent (see below)
#   ./build status       # what is in dist/, with checksums
#   ./build shell        # nix develop (cargo + python for the server)
#   ./build clean        # remove dist/ (the nix store is left alone)
#
# ONE COMMAND, TWO HOSTS. On Linux (NixOS amd64, or any Linux with nix) the
# build runs here directly. On macOS it runs inside an Apple-container NixOS
# VM, because nix on macOS is *-darwin and can never run a Linux builder, while
# the firmware build needs Linux userland plus the 2008 i686 ARM toolchain.
# Both paths call the same bin/nix-build.sh, so the same host architecture
# rebuilds the same bytes. They are not the same across architectures: the 2008
# cross-compiler and rustc both emit different code on aarch64 than on x86_64
# (firmware/README.md, "Build-host architecture"). `./build repro` checks the
# invariants that make a host self-consistent (forced rebuild, the qemu-i386
# toolchain path, -j1, the git-archived kernel) and prints the sha256 to compare
# against the other machine.
#
# Environment:
#   NEST_ATTACK_DIR   vendored GTVHacker tree        (default ./NestDFUAttack)
#   NEST_DIST         artifact directory             (default ./dist)
#   NEST_DETACH=1     macOS only: start the build and return; finish with
#                     ./build status (or ./build wait) to collect artifacts
#   NEST_TOOLCHAIN    auto|native|qemu               (default auto, see firmware/)
#   NEST_MAKE_JOBS    make -j for the kernel         (default: nix's core count)
#   NEST_BUILD_HOST   user@host: build on a remote native x86_64 Linux host and
#                     copy the artifacts back — the canonical image bytes, from
#                     a Mac that cannot produce them itself
#   NEST_BUILD_ATTACK path on that host to a NestDFUAttack checkout at the
#                     pinned commit (required with NEST_BUILD_HOST)
#   NEST_BUILD_DIR    scratch directory under the remote HOME
#                     (default nest-mac-build)
#   NEST_BUILD_TIMESTAMP / NEST_BUILD_USER / NEST_BUILD_HOST
#                     the build identity baked into vmlinux (already pinned)
set -eu

repo=$(cd "$(dirname "$0")" && pwd)
dist=${NEST_DIST:-$repo/dist}
attack=${NEST_ATTACK_DIR:-$repo/NestDFUAttack}

# Recorded in every artifact manifest: which source built it, and whether that
# source was dirty (bin/container.sh does the same for the VM path).
rev=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo unknown)
if [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]; then
    rev="${rev}-dirty"
fi
export NEST_HOST_REV=${NEST_HOST_REV:-$rev}

os=$(uname -s)
case $os in
    Darwin) via=container ;;
    *) via=native ;;
esac
# A remote native x86_64 Linux host overrides both. It is how this Mac gets the
# canonical image bytes when it cannot compile them itself (aarch64 differs, and
# an amd64 Apple container runs under Rosetta, which mangles argv[0] — see
# bin/container.sh and firmware/README.md).
if [ -n "${NEST_BUILD_HOST:-}" ]; then
    via=remote
fi

die() { echo "build: $*" >&2; exit 1; }

attr_for() {
    case $1 in
        firmware) echo firmware ;;
        server) echo nest-ondevice ;;
        initramfs) echo initramfs ;;
        *) return 1 ;;
    esac
}

need_attack() {
    [ -d "$attack/Dev" ] ||
        die "no GTVHacker tree at $attack — run 'git submodule update --init NestDFUAttack' or set NEST_ATTACK_DIR"
}

# Drive a remote native x86_64 Linux builder and bring the artifacts back. The
# bytes are that host's, which is the point: they match the reference image.
# Foreground only — the detached/collect model lives in the container scratch.
remote_build() {
    host=$NEST_BUILD_HOST
    dir=${NEST_BUILD_DIR:-nest-mac-build}
    attack_remote=${NEST_BUILD_ATTACK:-}
    [ -n "$attack_remote" ] ||
        die "NEST_BUILD_HOST needs NEST_BUILD_ATTACK: the path on $host to a NestDFUAttack checkout at the pinned commit (the build reads Dev/linux, the base initramfs and the 2008 toolchain straight out of that tree)"

    # That tree is read as-is, so a stale checkout on the remote silently builds a
    # different image (trap 22). Compare it against the gitlink before starting.
    want=$(git -C "$repo" rev-parse HEAD:NestDFUAttack 2>/dev/null || echo unknown)
    have=$(ssh -o BatchMode=yes "$host" "git -C $attack_remote rev-parse HEAD" 2>/dev/null || echo none)
    if [ "$want" != "$have" ]; then
        echo "build: $host:$attack_remote is at ${have:-missing}, this repo pins ${want:-unknown}" >&2
        echo "build: check it out first:  ssh $host git -C $attack_remote checkout $want" >&2
        exit 1
    fi

    rev=$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo unknown)
    [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ] && rev=$rev-dirty
    echo "build: remote $host:$dir (rev $rev) — the artifact bytes are that host's"

    ssh -o BatchMode=yes "$host" "mkdir -p ~/$dir/out" || exit 1
    # The submodule and .git stay behind: the remote's pinned checkout supplies
    # them, and rsyncing a macOS working tree would carry the collapsed case-only
    # kernel paths across (trap 3).
    rsync -az --delete --exclude .git --exclude NestDFUAttack --exclude dist \
        --exclude target --exclude 'result*' "$repo/" "$host:$dir/src/" || exit 1

    # shellcheck disable=SC2029
    ssh -o BatchMode=yes "$host" "NEST_SRC=\$HOME/$dir/src NEST_OUT=\$HOME/$dir/out \
        NEST_ATTACK=$attack_remote NEST_HOST_REV=$rev \
        sh \$HOME/$dir/src/bin/nix-build.sh $*" || exit 1

    # Copy back exactly what the build listed, not everything in the directory:
    # that directory outlives the build and holds other targets' artifacts.
    for t in "$@"; do
        for f in $(ssh -o BatchMode=yes "$host" "cat ~/$dir/out/$t.files 2>/dev/null"); do
            scp -q -o BatchMode=yes "$host:$dir/out/$f" "$dist/$f" || exit 1
        done
        scp -q -o BatchMode=yes "$host:$dir/out/$t.manifest" "$dist/$t.manifest" || exit 1
    done
    echo "build: remote artifacts copied into $dist"
}

# The container keeps its own scratch (staged repo, logs, rc files) and exports
# finished artifacts; copy them into dist/ so both hosts look the same. Only the
# files each target listed in <target>.files are copied — that directory is
# reused across runs and targets, so a blanket copy drops two-day-old artifacts
# from an earlier build into dist/ beside a fresh uImage.
collect_from_vm() {
    [ "$via" = container ] || return 0
    vmout=$(sh "$repo/bin/container.sh" path)
    [ -d "$vmout" ] || return 0
    for list in "$vmout"/*.files; do
        [ -e "$list" ] || continue
        target=$(basename "$list" .files)
        for name in $(cat "$list"); do
            [ -f "$vmout/$name" ] || continue
            cp -f "$vmout/$name" "$dist/$name"
        done
        [ -f "$vmout/$target.manifest" ] &&
            cp -f "$vmout/$target.manifest" "$dist/$target.manifest"
    done
}

show_dist() {
    [ -d "$dist" ] || { echo "build: nothing built yet (no $dist)"; return 0; }
    echo "artifacts in $dist:"
    found=0
    for f in "$dist"/*; do
        [ -e "$f" ] || continue
        case $f in *.log | *.rc | *.paths) continue ;; esac
        printf '  %-22s %8s  %s\n' "$(basename "$f")" "$(du -h "$f" | cut -f1)" \
            "$(sha256sum "$f" 2>/dev/null | cut -c1-16)"
        found=1
    done
    [ "$found" = 1 ] || echo "  (empty)"
}

case ${1:-help} in
    firmware | server | initramfs)
        target=$(attr_for "$1") || die "bad target"
        mkdir -p "$dist"
        need_attack
        if [ "$via" = remote ]; then
            remote_build "$target"
            show_dist
            exit 0
        fi
        if [ "$via" = native ]; then
            NEST_SRC=$repo NEST_OUT=$dist NEST_ATTACK=$attack \
                exec sh "$repo/bin/nix-build.sh" "$target"
        fi
        if [ "${NEST_DETACH:-}" = 1 ]; then
            exec sh "$repo/bin/container.sh" start "$target"
        fi
        sh "$repo/bin/container.sh" run "$target" || exit 1
        collect_from_vm
        show_dist
        ;;

    all)
        mkdir -p "$dist"
        need_attack
        if [ "$via" = remote ]; then
            remote_build firmware nest-ondevice initramfs
            show_dist
            exit 0
        fi
        if [ "$via" = native ]; then
            NEST_SRC=$repo NEST_OUT=$dist NEST_ATTACK=$attack \
                exec sh "$repo/bin/nix-build.sh" firmware nest-ondevice initramfs
        fi
        if [ "${NEST_DETACH:-}" = 1 ]; then
            echo "build: NEST_DETACH only drives one target; detaching firmware" >&2
            exec sh "$repo/bin/container.sh" start firmware
        fi
        # One VM round trip per target, in dependency order (the kernel build
        # also builds the server it embeds).
        for target in firmware nest-ondevice initramfs; do
            sh "$repo/bin/container.sh" run "$target" || exit 1
        done
        collect_from_vm
        show_dist
        ;;

    wait)
        [ "$via" = container ] || die "wait only applies on macOS (the container path)"
        target=$(attr_for "${2:-firmware}") || target=${2:-firmware}
        sh "$repo/bin/container.sh" wait "$target" || exit 1
        collect_from_vm
        show_dist
        ;;

    ui)
        # The schedule SPA (nest-ondevice-server/ui). Bun compiles src/ into
        # ui/dist, which build.rs embeds into the server binary. Deliberately
        # outside the nix build — there is no Bun in the firmware derivation and
        # the committed bundle keeps the image reproducible, the same way the
        # vendored hubitat/ Groovy is pushed rather than built.
        uidir=$repo/nest-ondevice-server/ui
        bunbin=$uidir/node_modules/.bin/bun
        [ -x "$bunbin" ] || bunbin=$(command -v bun || true)
        [ -n "$bunbin" ] || die "bun not found: install it (https://bun.sh), or npm i -D bun in $uidir"
        if [ ! -d "$uidir/node_modules" ]; then
            echo "ui: installing dependencies (npm ci)"
            (cd "$uidir" && npm ci) || die "npm ci failed"
        fi
        (cd "$uidir" && "$bunbin" run build.ts) || die "ui build failed"
        (cd "$uidir" && "$bunbin" run test/run.ts) || die "ui render test failed"
        echo "ui: ui/dist rebuilt — rebuild the server to embed it (./build server)"
        ;;

    qemu)
        [ "$via" = native ] || die "qemu smoke test runs on Linux; on macOS: ./build vm, then NEST_ATTACK_DIR=/nest/attack NEST_LINUX_DIR=/tmp/nest-linux-fixed/Dev/linux sh /src/firmware/qemu-smoke.sh"
        exec sh "$repo/firmware/qemu-smoke.sh"
        ;;

    test)
        # The checks that need no thermostat: firmware/test-image.sh runs the two
        # halves that execute on the device (the flash-root installer and the
        # initramfs injector) against fixtures. The server's own smoke test needs
        # a host-built server running — AGENTS.md § "Build & verify".
        exec "$repo/firmware/test-image.sh"
        ;;

    repro)
        [ "$via" = native ] || die "run the repro check on Linux, or inside the VM: ./build vm then NEST_ATTACK_DIR=/nest/attack sh /src/bin/repro-check.sh"
        shift
        if [ "${1:-}" = all ]; then shift; fi
        exec sh "$repo/bin/repro-check.sh" "$@"
        ;;

    status)
        if [ "$via" = container ]; then
            sh "$repo/bin/container.sh" status || true
            collect_from_vm
        fi
        show_dist
        ;;

    shell | develop)
        exec nix develop "$repo"
        ;;

    clean)
        rm -rf "$dist"
        echo "build: removed $dist (nix store untouched; 'nix store gc' to reclaim)"
        ;;

    help | -h | --help | "")
        # The header comment is the documentation; print it without hard-coding
        # a line range that shifts every time a verb is added.
        awk 'NR == 1 { next } /^set -eu/ { exit } { print }' "$0"
        ;;

    *)
        die "unknown verb '$1' (try: firmware|server|initramfs|all|qemu|test|repro|status|shell|clean)"
        ;;
esac
